# ==============================================================================
# Environment Configuration Template
# Copy this file to .env:  cp .env.example .env
# ==============================================================================

# Application Environment: 'development', 'staging', 'production'
ENVIRONMENT=development
DEBUG=true
PORT=8000

# Security / JWT Settings
# Generate a secure key: openssl rand -hex 32
JWT_SECRET_KEY=change_this_to_a_very_secure_secret_key_at_least_32_chars_long
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Allowed CORS Origins (comma-separated list or "*" for local dev)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8000

# ------------------------------------------------------------------------------
# PostgreSQL Configuration
# ------------------------------------------------------------------------------
# Local Docker or local Postgres default:
# Note: FastAPI uses asyncpg (postgresql+asyncpg://)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/legal_ai_db

# For Render.com Postgres:
# Render gives URLs like 'postgres://user:pass@host/dbname'.
# Our application automatically converts 'postgres://' or 'postgresql://' to 'postgresql+asyncpg://'.

# ------------------------------------------------------------------------------
# Weaviate Vector Database Configuration
# ------------------------------------------------------------------------------
# Option A: Weaviate Cloud Services (WCS) - Recommended for Render free tier!
# Sign up free at: https://console.weaviate.cloud/
WEAVIATE_URL=https://your-cluster-name.weaviate.network
WEAVIATE_API_KEY=your_weaviate_api_key_here

# Option B: Local Docker Weaviate (used in docker-compose.yml)
# WEAVIATE_URL=http://localhost:8080
# WEAVIATE_API_KEY=

# Optional OpenAI or HuggingFace API key if using Weaviate generative/vectorizer modules
# OPENAI_API_KEY=

# ------------------------------------------------------------------------------
# Groq LLM Configuration (Indian Legal Advisory Opinion RAG)
# ------------------------------------------------------------------------------
# Get free key at https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here
GROQ_DEFAULT_MODEL=qwen/qwen3.8-27b
